<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTarea"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Checkbox para marcar tareas como completadas o en progreso[cite: 1] -->
        <CheckBox
            android:id="@+id/cbCompletada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/estado_completada"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItemTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Título de Tarea"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <!-- Etiqueta de Estado[cite: 1] -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEstadoItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendiente"
                    android:textSize="10sp"
                    app:chipMinHeight="24dp"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/estado_pendiente"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción breve..."
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Contenedor para mostrar fechas y usuario asignado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvItemFechaCreacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Creado: 07/09/2026"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvItemFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vence: 12/10/2026 00:00"
                        android:textSize="11sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvItemAsignado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignado: cruiz"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="italic"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón lateral para eliminar tareas -->
        <ImageButton
            android:id="@+id/btnEliminarTarea"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/estado_pendiente"
            android:contentDescription="Eliminar tarea"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>